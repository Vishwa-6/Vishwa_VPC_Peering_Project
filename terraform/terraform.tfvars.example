# Copy to terraform.tfvars and edit.
region             = "ap-south-1"
student_name       = "YourName"
my_ip_cidr         = "203.0.113.25/32" # curl -s https://checkip.amazonaws.com  (then add /32)
enable_peering     = false             # stage 1 = baseline. Change to true for stage 2.
app_b_icmp_enabled = true
